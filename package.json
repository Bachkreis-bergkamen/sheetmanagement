{
	"name": "sheetmanagement",
	"version": "0.15.0",
	"private": true,
	"license": "MIT",
	"repository": "github:lgreil/sheetmanagement",
	"type": "module",
	"description": "Sheet music and concert overview for orchestras, built on Google Drive, Google Calendar and Google Sheets.",
	"scripts": {
		"dev": "vite dev",
		"dev:demo": "vite dev --mode demo",
		"build": "vite build && node scripts/wrap-worker.mjs",
		"preview": "pnpm build && wrangler dev",
		"deploy": "pnpm build && wrangler deploy",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@cantoo/pdf-lib": "2.11.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"pdfjs-dist": "6.5.438",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tesseract.js": "7.0.0",
		"typescript": "^6.0.0",
		"vite": "^8.3.5",
		"vitest": "^5.1.0",
		"wrangler": "^4.156.0",
		"zxing-wasm": "3.1.6"
	},
	"engines": {
		"node": ">=22.17"
	},
	"packageManager": "pnpm@10.7.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd"
		]
	}
}
